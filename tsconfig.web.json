{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "include": ["./src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/preload/*.d.ts", "src/shared/**/*.ts"],
  // Reads the stylesheets from disk in node: type-checked with the node config.
  "exclude": ["src/renderer/styles/token-usage.test.ts"]
}
