---
/* Status glyphs: the same shapes as the app's StatusGlyph (Figma 9:14). */
---

<svg width="0" height="0" class="defs" aria-hidden="true">
  <symbol id="g-running" viewBox="0 0 14 14">
    <circle cx="7" cy="7" r="5.1" fill="none" stroke="var(--rule-2)" stroke-width="1.8"></circle>
    <path class="spin" d="M7 1.9 A5.1 5.1 0 0 1 9.32 11.54" fill="none" stroke="var(--working)" stroke-width="1.8"></path>
  </symbol>
  <symbol id="g-needs_you" viewBox="0 0 14 14">
    <circle cx="7" cy="7" r="7" fill="var(--accent-bg)"></circle>
    <circle cx="7" cy="7" r="4" fill="var(--accent)"></circle>
  </symbol>
  <symbol id="g-done_unread" viewBox="0 0 14 14"><circle cx="7" cy="7" r="4" fill="var(--done)"></circle></symbol>
  <symbol id="g-error" viewBox="0 0 14 14"><circle cx="7" cy="7" r="4" fill="var(--error)"></circle></symbol>
  <symbol id="g-idle" viewBox="0 0 14 14"><circle cx="7" cy="7" r="3.25" fill="none" stroke="var(--idle)" stroke-width="1.5"></circle></symbol>
</svg>
